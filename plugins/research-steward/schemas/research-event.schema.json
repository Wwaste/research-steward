{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "project_initialized",
        "candidate_declared",
        "packet_frozen",
        "run_started",
        "agent_contribution",
        "review_barrier_closed",
        "adjudication",
        "verification",
        "provisional_review",
        "acceptance",
        "package_created",
        "delivery_recorded",
        "delivery_verified",
        "block_resolved",
        "blocked"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "actor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "adapter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "id",
        "role"
      ],
      "additionalProperties": false
    },
    "input_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "depends_on": {
      "default": [],
      "maxItems": 512,
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      }
    },
    "visibility": {
      "default": "shared",
      "type": "string",
      "enum": [
        "shared",
        "blind",
        "private"
      ]
    },
    "status": {
      "default": "complete",
      "type": "string",
      "enum": [
        "complete",
        "blocked",
        "failed"
      ]
    },
    "summary": {
      "default": "",
      "type": "string",
      "maxLength": 100000
    },
    "uncertainties": {
      "default": [],
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "evidence": {
      "default": [],
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "kind": {
            "type": "string",
            "enum": [
              "source",
              "artifact",
              "command",
              "observation",
              "other"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 4000
          }
        },
        "required": [
          "locator",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "default": [],
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "evidence": {
            "default": [],
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "locator": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "source",
                    "artifact",
                    "command",
                    "observation",
                    "other"
                  ]
                },
                "note": {
                  "type": "string",
                  "maxLength": 4000
                }
              },
              "required": [
                "locator",
                "kind"
              ],
              "additionalProperties": false
            }
          },
          "uncertainty": {
            "default": "",
            "type": "string",
            "maxLength": 4000
          },
          "remediation": {
            "default": "",
            "type": "string",
            "maxLength": 10000
          }
        },
        "required": [
          "id",
          "severity",
          "claim",
          "evidence",
          "uncertainty",
          "remediation"
        ],
        "additionalProperties": false
      }
    },
    "decisions": {
      "default": [],
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "disposition": {
            "type": "string",
            "enum": [
              "accept",
              "partial",
              "reject",
              "defer"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "action": {
            "default": "",
            "type": "string",
            "maxLength": 10000
          },
          "owner": {
            "default": "",
            "type": "string",
            "maxLength": 100
          },
          "change_evidence": {
            "default": "",
            "type": "string",
            "maxLength": 10000
          }
        },
        "required": [
          "finding_id",
          "disposition",
          "rationale",
          "action",
          "owner",
          "change_evidence"
        ],
        "additionalProperties": false
      }
    },
    "metadata": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "protocol_version": {
      "type": "string",
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "sequence": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "project_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "previous_event_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "event_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "type",
    "actor",
    "depends_on",
    "visibility",
    "status",
    "summary",
    "uncertainties",
    "evidence",
    "findings",
    "decisions",
    "metadata",
    "protocol_version",
    "event_id",
    "sequence",
    "timestamp",
    "project_id",
    "previous_event_hash",
    "event_hash"
  ],
  "additionalProperties": false,
  "$id": "https://github.com/Wwaste/research-steward/schemas/research-event.schema.json",
  "title": "Research Steward immutable event"
}
