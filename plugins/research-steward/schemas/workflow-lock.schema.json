{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "lock_version": {
      "type": "number",
      "const": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "plan_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "preset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "preset_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generator_version": {
      "type": "string",
      "const": "planner/0.2.0"
    },
    "packet_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "provider_routes": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "adapter": {
            "type": "string",
            "enum": [
              "kimi",
              "qoder",
              "grok",
              "fake"
            ]
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "route": {
            "type": "string",
            "enum": [
              "subscription_cli",
              "fake"
            ]
          }
        },
        "required": [
          "adapter",
          "route"
        ],
        "additionalProperties": false
      }
    },
    "skill_ids": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "capability_gaps": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    }
  },
  "required": [
    "lock_version",
    "created_at",
    "plan_hash",
    "preset_id",
    "preset_version",
    "generator_version",
    "packet_id",
    "provider_routes",
    "skill_ids",
    "capability_gaps"
  ],
  "additionalProperties": false,
  "$id": "https://github.com/Wwaste/research-steward/schemas/workflow-lock.schema.json",
  "title": "Research Steward workflow lock"
}
