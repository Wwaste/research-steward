RESEARCH_STEWARD_ROOTS=/srv/research-steward/projects
RESEARCH_STEWARD_HTTP_HOST=127.0.0.1
RESEARCH_STEWARD_HTTP_PORT=8799
# Generate with: openssl rand -hex 32
RESEARCH_STEWARD_HTTP_TOKEN=
RESEARCH_STEWARD_ALLOWED_HOSTS=127.0.0.1,replace-with-tailnet-dns-name
RESEARCH_STEWARD_ALLOWED_ORIGINS=https://replace-with-tailnet-dns-name
# Default hardened VPS deployment is ledger-only. For a separately designed
# provider-enabled host with installed/authenticated CLIs, consider setting:
# RESEARCH_STEWARD_MAX_PROVIDER_CONCURRENCY=3
